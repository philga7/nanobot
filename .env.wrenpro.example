# ─── WrenPro environment (DoD laptop, local-only) ───────────────────────────
# Copy to ~/.env.wrenpro and fill in absolute paths.

# ─── Instance identity ──────────────────────────────────────────────────────
NANOBOT_AGENTS__DEFAULTS__INSTANCE_NAME=WrenPro
NANOBOT_AGENTS__DEFAULTS__WORKSPACE=~/.wrenpro/workspace

# ─── Ollama (local LLM) ────────────────────────────────────────────────────
# No API key needed for local Ollama.
NANOBOT_PROVIDERS__OLLAMA__API_BASE=http://localhost:11434/v1

# Default model — switch between sizes as needed:
#   gemma4:27b  (full, requires ~20 GB VRAM)
#   gemma4:4b   (light, runs on integrated GPU / CPU)
NANOBOT_AGENTS__DEFAULTS__MODEL=gemma4:27b
NANOBOT_AGENTS__DEFAULTS__PROVIDER=ollama

# ─── SearXNG (local search) ────────────────────────────────────────────────
SEARXNG_BASE_URL=http://localhost:8084
NANOBOT_TOOLS__WEB__SEARCH__PROVIDER=searxng
NANOBOT_TOOLS__WEB__SEARCH__BASE_URL=${SEARXNG_BASE_URL}

# ─── MCP: Todo ──────────────────────────────────────────────────────────────
TODO_DB_PATH=/absolute/path/to/wrenpro/todos.db

# ─── MCP: Obsidian ──────────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=/absolute/path/to/obsidian/vault
